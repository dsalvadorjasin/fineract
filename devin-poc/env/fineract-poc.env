# Overrides applied after config/docker/env/*.env for the Devin PoC stack.
FINERACT_SERVER_SSL_ENABLED=false
FINERACT_SERVER_PORT=8080
FINERACT_DEFAULT_TENANTDB_TIMEZONE=UTC
FINERACT_DEFAULT_TENANTDB_HOSTNAME=db
FINERACT_HIKARI_JDBC_URL=jdbc:postgresql://db:5432/fineract_tenants
FINERACT_SECURITY_CORS_ENABLED=true
FINERACT_SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=*
JAVA_TOOL_OPTIONS=-Xmx2G -XX:+UseContainerSupport -XX:TieredStopAtLevel=1 -XX:+UseStringDeduplication --add-exports=java.naming/com.sun.jndi.ldap=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.security=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.management/javax.management=ALL-UNNAMED --add-opens=java.naming/javax.naming=ALL-UNNAMED
